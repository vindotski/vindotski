# production, or preview (dev.ski.vin): preview-only routes like /_style.
PUBLIC_ENV=preview
SITE_NAME=ski.vin

# The CMS. Production reads published content with a read-only token; previews
# read drafts with the preview token.
CMS_URL=http://localhost:1337
CMS_TOKEN=
CMS_STATUS=published
# Shared with the Strapi webhook that calls /api/revalidate (openssl rand -hex 32).
REVALIDATE_SECRET=
