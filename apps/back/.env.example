# production, or preview (dev.ski.vin): preview-only routes like /_style.
PUBLIC_ENV=preview
SITE_NAME=ski.vin
# vin.ski's origin: where the Sun and pulling past the top lead (ADRs 0017, 0019).
FRONT_URL=http://localhost:3001

# The CMS (https in production). With PUBLIC_ENV=production it reads published
# content (the site's read-only token); with preview, drafts (the preview token).
CMS_URL=http://localhost:3000
CMS_TOKEN=
# Shared with the Strapi webhook that calls /api/revalidate: at least 32 characters (openssl rand -hex 32).
REVALIDATE_SECRET=
