# production: indexable, no underscore routes. preview: noindex, /_style and /_teaser.
PUBLIC_ENV=preview
# The public origin: canonical URLs, sitemap, OG tags.
PUBLIC_SITE_URL=http://localhost:3001
PUBLIC_SITE_NAME=Ivan Vinski

# The CMS, read at build time. Production reads published content with a
# read-only token; previews read drafts with the preview token.
CMS_URL=http://localhost:3000
CMS_TOKEN=
CMS_STATUS=published

# true: only / (the teaser) is served, every other page is a 404. Ignored on previews.
PUBLIC_TEASER=false

# The easter egg target (ADR 0008). Baked in encoded; never in the HTML.
PUBLIC_ALT_URL=http://localhost:3002
