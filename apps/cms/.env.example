# Server
HOST=0.0.0.0
PORT=3000
# The public URL: https://vinski.xyz in production.
PUBLIC_URL=http://localhost:3000
# true behind a reverse proxy (Caddy, Cloudflare).
IS_PROXIED=false

# Secrets: generate each with `openssl rand -base64 16` (APP_KEYS takes four, comma-separated).
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# Database (docker-compose.yml reads these too)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
DATABASE_NAME=vindotski_cms
DATABASE_USERNAME=vindotski
DATABASE_PASSWORD=
DATABASE_SSL=false
