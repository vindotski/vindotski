{
  "kind": "collectionType",
  "collectionName": "fragments",
  "info": {
    "singularName": "fragment",
    "pluralName": "fragments",
    "displayName": "Fragment",
    "description": "Pieces of the Underground (ski.vin): process, notes, art, music, photos, unpolished projects."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "process",
        "note",
        "art",
        "music",
        "photo",
        "project"
      ],
      "default": "process",
      "required": true
    },
    "body": {
      "type": "blocks"
    },
    "media": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "videos",
        "audios"
      ]
    }
  }
}
