{
  "name": "vindotski",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter front --filter back dev",
    "dev:front": "pnpm --filter front dev",
    "dev:back": "pnpm --filter back dev",
    "dev:cms": "pnpm --filter cms dev",
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm --recursive --if-present run check"
  }
}
